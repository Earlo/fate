{
  "name": "fate",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "prisma migrate deploy --config prisma.config.ts && next build",
    "build:ci": "next build",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "dev": "next dev",
    "postinstall": "npm run prisma:generate",
    "lint": "oxlint .",
    "prettier": "prettier --write .",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.109",
    "@ai-sdk/react": "4.0.167",
    "@aws-sdk/client-s3": "3.1163.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "ably": "2.30.0",
    "ai": "7.0.163",
    "bcrypt": "6.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "openai": "7.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/bcrypt": "6.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "oxlint": "1.91.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x || 25.x || 26.x"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "bcrypt@6.0.0": true,
    "prisma@7.10.0": true,
    "sharp@0.34.5": true
  }
}
